{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lu Dev",
  "version": "0.1.0",
  "identifier": "dev.lu.desktop",
  "build": {
    "frontendDist": "web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost https:; media-src 'self' asset: http://asset.localhost https:; frame-src https://www.youtube-nocookie.com; connect-src ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": ["**/*.png", "**/*.jpg", "**/*.jpeg", "**/*.gif", "**/*.webp", "**/*.bmp", "**/*.svg", "**/*.avif", "**/*.mp3", "**/*.wav", "**/*.ogg", "**/*.oga", "**/*.flac", "**/*.m4a", "**/*.aac", "**/*.opus", "**/*.mp4", "**/*.webm", "**/*.mov", "**/*.m4v", "**/*.ogv",
                  "**/*.PNG", "**/*.JPG", "**/*.JPEG", "**/*.GIF", "**/*.WEBP", "**/*.MP3", "**/*.MP4", "**/*.WAV", "**/*.MOV"]
      }
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico", "icons/icon.png"]
  }
}
